<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="360.0" prefWidth="380.0" spacing="14.0" stylesheets="@../css/login-view.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.aguil.aguilonchas.controller.LoginController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <children>
      <Label stylesheets="@../css/login-view.css" text="Iniciar sesión">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <Label text="Sistema de reclutamiento" />
      <TextField fx:id="txtUsuario" promptText="Nombre de usuario" />
      <PasswordField fx:id="txtContrasena" onAction="#iniciarSesion" promptText="Contraseña" />
      <Button defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#iniciarSesion" text="Entrar" />
      <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#irARegistro" text="Crear una cuenta" />
   </children>
</VBox>
