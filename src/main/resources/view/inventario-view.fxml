<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="560.0" prefWidth="1100.0" stylesheets="@../css/inventario-view.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.aguil.aguilonchas.controller.InventarioController">
   <top>
      <HBox alignment="CENTER_LEFT" spacing="20.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="12.0" left="16.0" right="16.0" top="12.0" />
         </padding>
         <children>
            <Label text="Inventario de aspirantes">
               <font>
                  <Font name="System Bold" size="22.0" />
               </font>
            </Label>
            <Label fx:id="lblUsuario" text="Usuario" HBox.hgrow="ALWAYS" />
            <Button mnemonicParsing="false" onAction="#cerrarSesion" text="Cerrar sesión" />
         </children>
      </HBox>
   </top>
   <center>
      <TableView fx:id="tblAspirantes" BorderPane.alignment="CENTER">
         <columns>
            <TableColumn fx:id="colId" prefWidth="50.0" text="ID" />
            <TableColumn fx:id="colNombre" prefWidth="110.0" text="Nombre" />
            <TableColumn fx:id="colApellido" prefWidth="110.0" text="Apellido" />
            <TableColumn fx:id="colCorreo" prefWidth="190.0" text="Correo" />
            <TableColumn fx:id="colTelefono" prefWidth="100.0" text="Teléfono" />
            <TableColumn fx:id="colDireccion" prefWidth="170.0" text="Dirección" />
            <TableColumn fx:id="colEdad" prefWidth="55.0" text="Edad" />
         </columns>
         <BorderPane.margin>
            <Insets bottom="16.0" left="16.0" right="8.0" />
         </BorderPane.margin>
      </TableView>
   </center>
   <right>
      <VBox prefWidth="260.0" spacing="10.0" BorderPane.alignment="CENTER">
         <padding>
            <Insets bottom="16.0" left="8.0" right="16.0" />
         </padding>
         <children>
            <Label text="Datos del aspirante">
               <font>
                  <Font name="System Bold" size="15.0" />
               </font>
            </Label>
            <TextField fx:id="txtNombre" promptText="Nombre" />
            <TextField fx:id="txtApellido" promptText="Apellido" />
            <TextField fx:id="txtCorreo" promptText="Correo" />
            <TextField fx:id="txtTelefono" promptText="Teléfono" />
            <TextField fx:id="txtDireccion" promptText="Dirección" />
            <TextField fx:id="txtEdad" promptText="Edad" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#agregar" text="Agregar" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#actualizar" text="Actualizar" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#eliminar" text="Eliminar" />
            <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#limpiar" text="Limpiar" />
         </children>
      </VBox>
   </right>
</BorderPane>
