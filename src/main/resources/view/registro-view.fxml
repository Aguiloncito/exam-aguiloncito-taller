<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<VBox alignment="CENTER" prefHeight="470.0" prefWidth="380.0" spacing="14.0" stylesheets="@../css/registro-view.css" xmlns="http://javafx.com/javafx/26" xmlns:fx="http://javafx.com/fxml/1" fx:controller="main.java.com.aguil.aguilonchas.controller.RegistroController">
   <padding>
      <Insets bottom="30.0" left="40.0" right="40.0" top="30.0" />
   </padding>
   <children>
      <Label text="Registro de usuario">
         <font>
            <Font name="System Bold" size="24.0" />
         </font>
      </Label>
      <TextField fx:id="txtUsuario" promptText="Nombre de usuario" />
      <TextField fx:id="txtCorreo" promptText="Correo electrónico" />
      <PasswordField fx:id="txtContrasena" promptText="Contraseña (mínimo 6 caracteres)" />
      <PasswordField fx:id="txtConfirmacion" promptText="Confirmar contraseña" />
      <ComboBox fx:id="cmbRol" maxWidth="1.7976931348623157E308" promptText="Seleccione un rol" />
      <Button defaultButton="true" maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#registrar" text="Registrarse" />
      <Button maxWidth="1.7976931348623157E308" mnemonicParsing="false" onAction="#volver" text="Volver al inicio de sesión" />
   </children>
</VBox>
